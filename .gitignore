!.gitignore

# build artefacts
/build

# zig build artefacts (disjoint from the cmake ones during coexistence)
/zig-out/
/.zig-cache/
/zig-pkg/

# imgui window layout, written by both builds at exit. Worth ignoring beyond
# the usual tidiness: it persists window positions across runs, so a stale one
# silently changes what a screenshot gate captures.
/imgui.ini

# user
/.vs/
/.vscode/
/.cache/
/compile_commands.json

# python
__pycache__/
*.py[cod]
*$py.class
